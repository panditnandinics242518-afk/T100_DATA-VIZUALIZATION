      <aliases enabled='yes' />
      <column caption='PHYSICS_CLEAN' datatype='real' name='[Calculation_0892839552741376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(FLOAT(REPLACE(STR([Physics]), &apos;%&apos;, &apos;&apos;)), 0)' />
      </column>
      <column caption='Attendance_clean' datatype='real' name='[Calculation_0892839554039809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(TRIM(REPLACE(STR([Attendance]), &apos;%&apos;, &apos;&apos;)))' />
      </column>
      <column caption='Math_clean' datatype='integer' name='[Calculation_0892839554441218]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Math], 0)' />
      </column>
      <column caption='Chemistry_Clean' datatype='integer' name='[Calculation_0892839554691075]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Chemistry],0)' />
      </column>
      <column caption='Clean_Score' datatype='real' name='[Calculation_0892839563227140]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(FLOAT(REPLACE(STR([Pivot Field Values]), &apos;%&apos;, &apos;&apos;)), 0)' />
      </column>
      <column caption='Semester' datatype='string' name='[Calculation_0892839564926981]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Table Name], &quot;Sem1&quot;) &#13;&#10;THEN &quot;Semester 1&quot; &#13;&#10;ELSEIF CONTAINS([Table Name], &quot;Sem2&quot;) &#13;&#10;THEN &quot;Semester 2&quot; ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Total_Score' datatype='real' name='[Calculation_0892839567380487]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0892839554441218] + [Calculation_0892839552741376] + [Calculation_0892839554691075] +&#13;&#10;[Programming]' />
      </column>
      <column caption='Overall_percentage' datatype='real' default-format='p0.0%' name='[Calculation_0892839567564808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0892839567380487] / 400.0' />
      </column>
      <column caption='Performance_Band' datatype='string' name='[Calculation_0892839568089097]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0892839567564808] &gt;= 0.85 &#13;&#10;THEN &quot;Distinction&quot; &#13;&#10;ELSEIF [Calculation_0892839567564808] &gt;= 0.75 &#13;&#10;THEN &quot;First Class&quot; ELSEIF [Calculation_0892839567564808] &gt;= 0.60 &#13;&#10;THEN &quot;Second Class&quot;&#13;&#10;ELSE &quot;Needs Academic Support&quot;&#13;&#10;END' />
      </column>
      <column caption='Attendance_Status' datatype='string' name='[Calculation_0892839568449546]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0892839554039809] &gt;= 75 &#13;&#10;THEN &quot;Eligible (Good Standing)&quot; &#13;&#10;ELSE &quot;Shortage Warning (&lt;75%)&quot;&#13;&#10;END' />
      </column>
      <column caption='Dept_Average_Percentage_LOD' datatype='real' default-format='p0.0%' name='[Calculation_0892839569735691]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Dept_Info] : AVG([Calculation_0892839567564808]) }' />
      </column>
      <column caption='Student_Overall_Career_Average' datatype='real' name='[Calculation_0892839571582988]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Student_ID] : AVG([Calculation_0892839567564808]) }' />
      </column>
      <column caption='Variance_From_Dept_Average' datatype='real' name='[Calculation_0892839571972109]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0892839567564808] - [Calculation_0892839569735691]' />
      </column>
      <column caption='Benchmark_status' datatype='string' name='[Calculation_0892839572250638]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0892839571972109] &gt;= 0 &#13;&#10;THEN &quot;Above Department Benchmark&quot;&#13;&#10;ELSE &quot;Below Department Benchmark&quot;&#13;&#10;END' />
      </column>
